# Archivos que Git debe omitir; agrega aquí artefactos locales, no código fuente.

# Dependencias instaladas por npm.
node_modules/

# Caché y resultados generados por Expo.
.expo/
dist/
web-build/
expo-env.d.ts

# Credenciales y archivos nativos locales.
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Archivos temporales del empaquetador Metro.
.metro-health-check*

# Registros de depuración de gestores de paquetes.
npm-debug.*
yarn-debug.*
yarn-error.*

# Metadatos y claves locales de macOS.
.DS_Store
*.pem

# Variables de entorno locales que no deben compartirse.
.env*.local

# Caché de compilación de TypeScript.
*.tsbuildinfo

# Carpeta opcional para conservar una copia de ejemplo del proyecto.
example

# Carpetas nativas generadas automáticamente por Expo.
/ios
/android
