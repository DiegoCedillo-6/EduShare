{
  // Hereda las opciones base recomendadas para proyectos Expo.
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // Activa comprobaciones estrictas de tipos en el código TypeScript.
    "strict": true,
    // Permite importar módulos de src y recursos desde alias cortos.
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  // Incluye el código TypeScript de la app y los tipos generados por Expo.
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
